# Copy to `.env` for local development (Bun loads it automatically).
# Never commit your real `.env`.

# Admin dashboard login (HTTP Basic auth). Required unless ADMIN_AUTH_DISABLED=true.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Alternatively read the password from a file (Docker/Swarm secret):
# ADMIN_PASSWORD_FILE=/run/secrets/linktree_admin_password
# ADMIN_AUTH_DISABLED=false

# Ports / binding
HOST=0.0.0.0
PORT=3000
ADMIN_PORT=3001

# Where database.sqlite and analytics.sqlite are stored
DATA_DIR=db

# Public URL of your page – shows a "View site" button in the admin
# PUBLIC_URL=https://links.example.com

# Timezone used for analytics timestamps
TZ=UTC

# Trust X-Forwarded-* headers (keep true behind Cloudflare Tunnel / reverse proxy)
TRUST_PROXY=true

# Add sample links on the very first start
SEED_SAMPLE_LINKS=true

LOG_LEVEL=info
