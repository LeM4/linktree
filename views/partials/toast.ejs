<% if (locals.flash) { %>
<div x-data="{ show: true }"
     x-init="history.replaceState(null, '', location.pathname + location.hash); setTimeout(() => show = false, 3500)"
     x-show="show"
     x-transition:enter="transition duration-300 ease-out"
     x-transition:enter-start="opacity-0 translate-y-2"
     x-transition:leave="transition duration-200 ease-in"
     x-transition:leave-end="opacity-0 translate-y-2"
     role="status"
     class="fixed inset-x-4 bottom-4 z-50 mx-auto flex max-w-sm items-center gap-3 rounded-2xl px-4 py-3 text-sm font-medium shadow-lg ring-1 sm:right-6 sm:left-auto sm:bottom-6 <%= flash.type === 'error' ? 'bg-red-50 text-red-800 ring-red-200 dark:bg-red-950 dark:text-red-200 dark:ring-red-900' : 'bg-zinc-900 text-white ring-zinc-900 dark:bg-white dark:text-zinc-900 dark:ring-white' %>">
    <span class="grid size-6 shrink-0 place-items-center rounded-full <%= flash.type === 'error' ? 'bg-red-100 dark:bg-red-900' : 'bg-emerald-500 text-white' %>">
        <%- include('icon', { name: flash.type === 'error' ? 'x' : 'check', cls: 'size-3.5' }) %>
    </span>
    <span class="flex-1"><%= flash.message %></span>
    <button type="button" @click="show = false" class="opacity-60 transition hover:opacity-100" aria-label="Dismiss">
        <%- include('icon', { name: 'x', cls: 'size-4' }) %>
    </button>
</div>
<% } %>
