<div class="rounded-[2.5rem] border border-zinc-200 bg-zinc-900 p-2 shadow-xl shadow-zinc-900/10 dark:border-zinc-800"
     x-data @theme-preview.window="Object.entries($event.detail).forEach(([k, v]) => $el.style.setProperty('--pv-' + k, v))"
     style="--pv-bg: <%= palette.background %>; --pv-text: <%= palette.text %>; --pv-link: <%= palette.link %>; --pv-link-text: <%= palette.linkText %>; --pv-accent: <%= palette.accent %>;">
    <div class="relative h-[580px] overflow-hidden rounded-[2rem] font-sans transition-colors duration-300"
         style="background: radial-gradient(22rem 14rem at 50% -5rem, color-mix(in oklab, var(--pv-accent) 30%, transparent), transparent 72%), var(--pv-bg); color: var(--pv-text);">
        <div class="absolute top-2.5 left-1/2 h-[18px] w-20 -translate-x-1/2 rounded-full bg-black"></div>
        <div class="flex h-full flex-col items-center overflow-y-auto px-5 pt-14 pb-6 text-center">
            <% if (settings.profile_pic_url) { %>
                <img src="<%= settings.profile_pic_url %>" alt="" class="size-16 rounded-full object-cover shadow-lg">
            <% } else { %>
                <div class="grid size-16 place-items-center rounded-full text-xl font-semibold" style="background: color-mix(in oklab, var(--pv-text) 10%, transparent)"><%= (settings.username || '?').trim().charAt(0).toUpperCase() %></div>
            <% } %>
            <p class="mt-3 text-[15px] font-semibold tracking-tight"><%= settings.username %></p>
            <p class="mt-1 line-clamp-3 text-xs" style="color: color-mix(in oklab, var(--pv-text) 64%, transparent)"><%= settings.bio %></p>
            <% if (iconLinks.length) { %>
                <div class="mt-3 flex justify-center gap-3 opacity-70">
                    <% iconLinks.forEach(icon => { %>
                        <span class="size-4 [&>svg]:size-full"><%- icon.svg_code %></span>
                    <% }) %>
                </div>
            <% } %>
            <div class="mt-5 w-full space-y-2">
                <% const live = links.filter(l => l.enabled); %>
                <% live.forEach(link => { %>
                    <div class="truncate rounded-full px-4 py-2.5 text-[13px] font-medium shadow-sm"
                         style="background: var(--pv-link); color: var(--pv-link-text); border: 1px solid color-mix(in oklab, var(--pv-link-text) 11%, transparent)"><%= link.title %></div>
                <% }) %>
                <% if (!live.length) { %>
                    <p class="py-4 text-xs opacity-60">No visible links yet</p>
                <% } %>
            </div>
        </div>
    </div>
</div>
<p class="mt-3 text-center text-xs text-zinc-500 dark:text-zinc-400">Preview shows colors but not geo-blocking or theme effects.</p>
