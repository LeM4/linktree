{
  "name": "linktree",
  "version": "2.0.0",
  "description": "A lightweight, self-hosted, server-rendered Linktree clone with geo-blocking and privacy-friendly analytics.",
  "type": "module",
  "main": "main.js",
  "license": "ISC",
  "private": true,
  "scripts": {
    "start": "bun main.js",
    "start:public": "bun server.js",
    "start:admin": "bun admin-server.js",
    "dev": "bun run build:assets && concurrently -k -n app,css -c blue,magenta \"bun --watch main.js\" \"bun run dev:css\"",
    "dev:css": "tailwindcss -i ./styles/input.css -o ./public/styles.css --watch",
    "build": "bun run build:assets && bun run build:css",
    "build:assets": "bun scripts/build-assets.js",
    "build:css": "tailwindcss -i ./styles/input.css -o ./public/styles.css --minify",
    "test": "bun test",
    "cli": "bun cli.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/static": "^10.1.5",
    "@fastify/view": "^12.0.0",
    "countries-list": "^3.4.1",
    "ejs": "^7.0.1",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@fingerprintjs/fingerprintjs": "^5.0.0",
    "@fontsource/arvo": "^5.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "alpinejs": "^3.14.0",
    "chart.js": "^4.4.0",
    "concurrently": "^10.0.5",
    "htmx.org": "^2.0.4",
    "tailwindcss": "^4.3.3"
  }
}
