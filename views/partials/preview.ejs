<div class="rounded-[2.25rem] border border-zinc-200 bg-zinc-100 p-2.5 shadow-xl shadow-zinc-900/5 dark:border-zinc-800 dark:bg-zinc-900">
    <div class="relative h-[560px] overflow-hidden rounded-[1.75rem]" style="background: <%= palette.backgroundGradient %>; color: <%= palette.textColor %>;">
        <div class="absolute top-2 left-1/2 h-1.5 w-16 -translate-x-1/2 rounded-full bg-black/15"></div>
        <div class="h-full overflow-y-auto px-4 pt-8 pb-6 font-display">
            <div class="rounded-3xl p-5 shadow-lg" style="background: <%= palette.containerGradient %>;">
                <div class="flex flex-col items-center text-center">
                    <% if (settings.profile_pic_url) { %>
                        <img src="<%= settings.profile_pic_url %>" alt="" class="size-16 rounded-full object-cover shadow-md ring-2 ring-white/60">
                    <% } else { %>
                        <div class="grid size-16 place-items-center rounded-full bg-black/10 text-xl font-bold"><%= (settings.username || '?').trim().charAt(0).toUpperCase() %></div>
                    <% } %>
                    <p class="mt-3 font-bold"><%= settings.username %></p>
                    <p class="mt-1 line-clamp-3 text-xs opacity-80"><%= settings.bio %></p>
                </div>
                <% if (iconLinks.length) { %>
                    <div class="mt-3 flex justify-center gap-2.5">
                        <% iconLinks.forEach(icon => { %>
                            <span class="size-5 [&>svg]:size-full"><%- icon.svg_code %></span>
                        <% }) %>
                    </div>
                <% } %>
                <div class="mt-4 space-y-2">
                    <% const live = links.filter(l => l.enabled); %>
                    <% live.forEach(link => { %>
                        <div class="truncate rounded-xl px-3 py-2.5 text-center text-sm shadow-sm" style="background: <%= palette.linkColor %>; color: <%= palette.linkTextColor %>;"><%= link.title %></div>
                    <% }) %>
                    <% if (!live.length) { %>
                        <p class="py-4 text-center text-xs opacity-60">No visible links yet</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>
<p class="mt-3 text-center text-xs text-zinc-500 dark:text-zinc-400">Preview ignores geo-blocking and background themes.</p>
