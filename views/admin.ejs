<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/admin-head') %>
    <title>Dashboard · <%= settings.page_title || 'Linktree' %></title>
    <script>
        // Crops to a square and downsizes uploads so the data URL stays small.
        window.resizeAvatar = window.resizeAvatar || function (file, size = 320) {
            return new Promise((resolve, reject) => {
                const img = new Image();
                img.onload = () => {
                    const side = Math.min(img.width, img.height);
                    const canvas = document.createElement('canvas');
                    canvas.width = canvas.height = Math.min(size, side);
                    canvas.getContext('2d').drawImage(img, (img.width - side) / 2, (img.height - side) / 2, side, side, 0, 0, canvas.width, canvas.height);
                    URL.revokeObjectURL(img.src);
                    resolve(canvas.toDataURL('image/webp', 0.85));
                };
                img.onerror = reject;
                img.src = URL.createObjectURL(file);
            });
        };
    </script>
</head>
<body class="min-h-dvh bg-zinc-50 font-sans text-zinc-900 antialiased dark:bg-zinc-950 dark:text-zinc-100"
      hx-boost="true" hx-push-url="false" hx-indicator="body">
    <%- include('partials/admin-header') %>

    <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:py-10">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px]">
            <div class="min-w-0 space-y-6">
                <% const liveCount = links.filter(l => l.enabled).length; %>
                <div class="animate-fade-up">
                    <h1 class="text-2xl font-semibold tracking-tight">Dashboard</h1>
                    <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">Manage your links, profile and appearance.</p>

                    <div class="mt-5 grid grid-cols-3 gap-3">
                        <div class="card px-4 py-3">
                            <p class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Live links</p>
                            <p class="mt-0.5 text-xl font-semibold tabular-nums"><%= liveCount %><span class="text-sm font-normal text-zinc-400"> / <%= links.length %></span></p>
                        </div>
                        <div class="card px-4 py-3">
                            <p class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Social icons</p>
                            <p class="mt-0.5 text-xl font-semibold tabular-nums"><%= iconLinks.length %></p>
                        </div>
                        <div class="card px-4 py-3">
                            <p class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Theme</p>
                            <p class="mt-0.5 truncate text-xl font-semibold"><%= activeTheme?.name || 'None' %></p>
                        </div>
                    </div>

                    <nav class="-mx-1 mt-4 flex gap-1 overflow-x-auto px-1 pb-1" aria-label="Sections">
                        <a href="#links" class="section-link"><%- include('partials/icon', { name: 'link' }) %> Links</a>
                        <a href="#icons" class="section-link"><%- include('partials/icon', { name: 'grid' }) %> Social icons</a>
                        <a href="#profile" class="section-link"><%- include('partials/icon', { name: 'user' }) %> Profile</a>
                        <a href="#appearance" class="section-link"><%- include('partials/icon', { name: 'sparkle' }) %> Appearance</a>
                        <a href="#backup" class="section-link"><%- include('partials/icon', { name: 'database' }) %> Backup</a>
                    </nav>
                </div>

                <!-- Links -->
                <section id="links" class="card animate-fade-up [animation-delay:50ms]">
                    <div class="card-header">
                        <h2 class="card-title"><%- include('partials/icon', { name: 'link' }) %> Links</h2>
                        <span class="text-xs text-zinc-500 dark:text-zinc-400">Shown top to bottom on your page</span>
                    </div>
                    <div class="card-body space-y-4">
                        <form action="/admin/links" method="POST" class="grid gap-2 sm:grid-cols-[1fr_1.4fr_auto]">
                            <label class="sr-only" for="new-link-title">Title</label>
                            <input class="input" id="new-link-title" name="title" placeholder="Title" required maxlength="200">
                            <label class="sr-only" for="new-link-url">URL</label>
                            <input class="input" id="new-link-url" name="url" placeholder="https://example.com" required inputmode="url" autocomplete="off">
                            <button type="submit" class="btn btn-primary"><%- include('partials/icon', { name: 'plus' }) %> Add link</button>
                        </form>

                        <% if (links.length) { %>
                            <ul class="space-y-2">
                                <% links.forEach((link, index) => { %>
                                    <%- include('partials/link-row', { link, index, total: links.length }) %>
                                <% }) %>
                            </ul>
                        <% } else { %>
                            <div class="rounded-xl border border-dashed border-zinc-300 px-6 py-10 text-center dark:border-zinc-700">
                                <p class="font-medium">No links yet</p>
                                <p class="mt-1 text-sm text-zinc-500">Add your first link above – it appears on your page right away.</p>
                            </div>
                        <% } %>
                    </div>
                </section>

                <!-- Social icons -->
                <section id="icons" class="card animate-fade-up [animation-delay:100ms]">
                    <div class="card-header">
                        <h2 class="card-title"><%- include('partials/icon', { name: 'grid' }) %> Social icons</h2>
                        <span class="text-xs text-zinc-500 dark:text-zinc-400">Small icons below your bio</span>
                    </div>
                    <div class="card-body space-y-4">
                        <% if (iconLinks.length) { %>
                            <ul class="divide-y divide-zinc-100 rounded-xl border border-zinc-200 dark:divide-zinc-800 dark:border-zinc-800">
                                <% iconLinks.forEach((icon, index) => { %>
                                    <li class="flex items-center gap-3 px-3 py-2">
                                        <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 [&>svg]:size-5"><%- icon.svg_code %></span>
                                        <a href="<%= icon.url %>" target="_blank" rel="noopener" hx-boost="false" class="min-w-0 flex-1 truncate text-sm text-zinc-600 hover:text-zinc-900 hover:underline dark:text-zinc-400 dark:hover:text-zinc-100"><%= icon.url %></a>
                                        <form action="/admin/icon-links/<%= icon.id %>/move" method="POST">
                                            <input type="hidden" name="direction" value="up">
                                            <button type="submit" class="btn btn-ghost btn-icon size-8" aria-label="Move left" <%= index === 0 ? 'disabled' : '' %>><%- include('partials/icon', { name: 'chevron-up' }) %></button>
                                        </form>
                                        <form action="/admin/icon-links/<%= icon.id %>/move" method="POST">
                                            <input type="hidden" name="direction" value="down">
                                            <button type="submit" class="btn btn-ghost btn-icon size-8" aria-label="Move right" <%= index === iconLinks.length - 1 ? 'disabled' : '' %>><%- include('partials/icon', { name: 'chevron-down' }) %></button>
                                        </form>
                                        <form action="/admin/icon-links/<%= icon.id %>/delete" method="POST" hx-confirm="Delete this icon link?">
                                            <button type="submit" class="btn btn-danger btn-icon size-8" aria-label="Delete icon link"><%- include('partials/icon', { name: 'trash' }) %></button>
                                        </form>
                                    </li>
                                <% }) %>
                            </ul>
                        <% } %>

                        <form action="/admin/icon-links" method="POST" class="grid gap-3" x-data="{ open: <%= iconLinks.length ? 'false' : 'true' %> }">
                            <button type="button" class="btn btn-secondary justify-self-start" @click="open = !open" x-show="!open">
                                <%- include('partials/icon', { name: 'plus' }) %> Add icon link
                            </button>
                            <div x-show="open" x-cloak x-transition.opacity.duration.200ms class="grid gap-3">
                                <div>
                                    <label class="label" for="icon-url">URL</label>
                                    <input class="input" id="icon-url" name="url" placeholder="https://instagram.com/yourname" required inputmode="url">
                                </div>
                                <div>
                                    <label class="label" for="icon-svg">SVG icon</label>
                                    <textarea class="input min-h-24 font-mono text-xs" id="icon-svg" name="svg_code" placeholder="<svg viewBox=&quot;0 0 24 24&quot; fill=&quot;currentColor&quot;>…</svg>" required></textarea>
                                    <p class="hint">Paste an SVG (e.g. from simpleicons.org). Use <code>fill="currentColor"</code> so it matches your text color. Scripts and event handlers are rejected.</p>
                                </div>
                                <div class="flex justify-end gap-2">
                                    <button type="button" class="btn btn-ghost" @click="open = false">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Add icon</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </section>

                <!-- Profile -->
                <section id="profile" class="card animate-fade-up [animation-delay:150ms]">
                    <div class="card-header">
                        <h2 class="card-title"><%- include('partials/icon', { name: 'user' }) %> Profile</h2>
                    </div>
                    <form action="/admin/profile" method="POST" class="card-body grid gap-5"
                          x-data="{ src: '' }" x-init="src = $refs.pic.value">
                        <div class="flex flex-wrap items-center gap-4">
                            <div class="relative">
                                <img x-show="src" :src="src" alt="Profile picture" class="size-20 rounded-full object-cover shadow-sm ring-1 ring-zinc-200 dark:ring-zinc-700">
                                <div x-show="!src" class="grid size-20 place-items-center rounded-full bg-zinc-100 text-2xl font-semibold text-zinc-400 dark:bg-zinc-800">
                                    <%= (settings.username || '?').trim().charAt(0).toUpperCase() %>
                                </div>
                            </div>
                            <div class="flex flex-wrap gap-2">
                                <label class="btn btn-secondary">
                                    <%- include('partials/icon', { name: 'upload' }) %> Upload image
                                    <input type="file" accept="image/*" class="sr-only"
                                           @change="$event.target.files[0] && resizeAvatar($event.target.files[0]).then(url => { src = url; $refs.pic.value = url })">
                                </label>
                                <button type="button" class="btn btn-ghost" x-show="src" @click="src = ''; $refs.pic.value = ''">Remove</button>
                            </div>
                            <input type="hidden" name="profile_pic_url" x-ref="pic" value="<%= settings.profile_pic_url || '' %>">
                        </div>

                        <div class="grid gap-4 sm:grid-cols-2">
                            <div>
                                <label class="label" for="username">Display name</label>
                                <input class="input" type="text" id="username" name="username" value="<%= settings.username || '' %>" maxlength="100">
                            </div>
                            <div>
                                <label class="label" for="page_title">Browser tab title</label>
                                <input class="input" type="text" id="page_title" name="page_title" value="<%= settings.page_title || '' %>" maxlength="120">
                            </div>
                        </div>
                        <div>
                            <label class="label" for="bio">Bio</label>
                            <textarea class="input min-h-20" id="bio" name="bio" maxlength="1000"><%= settings.bio || '' %></textarea>
                        </div>
                        <div class="flex justify-end">
                            <button type="submit" class="btn btn-primary">Save profile</button>
                        </div>
                    </form>
                </section>

                <!-- Appearance -->
                <section id="appearance" class="card animate-fade-up [animation-delay:200ms]">
                    <div class="card-header">
                        <h2 class="card-title"><%- include('partials/icon', { name: 'sparkle' }) %> Appearance</h2>
                    </div>
                    <div class="card-body grid gap-7">
                        <% const swatch = (p) => ({ bg: p.background, link: p.link, text: p.text, accent: p.accent }); %>
                        <div>
                            <p class="label">Theme</p>
                            <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                                <% [{ id: null, name: 'None', description: 'Your own base color, no effects', sw: swatch(basePalette) },
                                    ...themes.map(t => ({ ...t, sw: t.colors ? { bg: t.colors.background, link: t.colors.link, text: t.colors.text, accent: t.colors.accent } : swatch(basePalette) }))
                                   ].forEach(t => { const active = (settings.active_theme || null) === t.id; %>
                                    <form action="<%= t.id ? '/admin/themes/activate' : '/admin/themes/deactivate' %>" method="POST">
                                        <% if (t.id) { %><input type="hidden" name="themeName" value="<%= t.id %>"><% } %>
                                        <button type="submit" aria-pressed="<%= active %>"
                                                class="group flex w-full cursor-pointer items-center gap-3 rounded-xl border p-2.5 text-left transition duration-200 hover:-translate-y-0.5 hover:shadow-md <%= active ? 'border-zinc-900 ring-1 ring-zinc-900 dark:border-white dark:ring-white' : 'border-zinc-200 hover:border-zinc-300 dark:border-zinc-800 dark:hover:border-zinc-700' %>">
                                            <span class="relative flex h-14 w-12 shrink-0 flex-col items-center justify-center gap-1 overflow-hidden rounded-lg px-1.5 shadow-inner ring-1 ring-black/5"
                                                  style="background: radial-gradient(circle at 50% 0%, color-mix(in oklab, <%= t.sw.accent %> 45%, transparent), transparent 70%), <%= t.sw.bg %>">
                                                <span class="size-2.5 rounded-full opacity-80" style="background: <%= t.sw.text %>"></span>
                                                <span class="h-2 w-full rounded-full" style="background: <%= t.sw.link %>; box-shadow: inset 0 0 0 1px color-mix(in oklab, <%= t.sw.text %> 15%, transparent)"></span>
                                                <span class="h-2 w-full rounded-full" style="background: <%= t.sw.link %>; box-shadow: inset 0 0 0 1px color-mix(in oklab, <%= t.sw.text %> 15%, transparent)"></span>
                                            </span>
                                            <span class="min-w-0 flex-1">
                                                <span class="flex items-center gap-1.5 text-sm font-medium"><%= t.name %>
                                                    <% if (active) { %><span class="text-emerald-600 dark:text-emerald-400"><%- include('partials/icon', { name: 'check', cls: 'size-3.5' }) %></span><% } %>
                                                </span>
                                                <span class="line-clamp-2 text-xs text-zinc-500 dark:text-zinc-400"><%= t.description || (t.colors ? '' : 'Uses your base color') %></span>
                                            </span>
                                        </button>
                                    </form>
                                <% }) %>
                            </div>
                            <p class="hint">Themes live in the <code>themes/</code> folder and are picked up automatically.</p>
                        </div>

                        <% if (activeColors) { %>
                            <form action="/admin/themes/colors" method="POST" class="rounded-xl border border-zinc-200 p-4 dark:border-zinc-800"
                                  x-data="{ colors: <%= JSON.stringify(activeColors) %>, defaults: <%= JSON.stringify(activeTheme.colors) %>,
                                            preview() { const c = this.colors; $dispatch('theme-preview', { bg: c.background, text: c.text, link: c.link, 'link-text': c.linkText, accent: c.accent }) } }">
                                <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
                                    <p class="text-sm font-semibold"><%= activeTheme.name %> colors</p>
                                    <p class="text-xs text-zinc-500 dark:text-zinc-400">Switching to <em>None</em> brings back your base color.</p>
                                </div>
                                <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                                    <% colorTokens.forEach(({ key, label }) => { %>
                                        <div class="flex items-center gap-2.5 rounded-lg p-1.5 transition" :class="colors.<%= key %> !== defaults.<%= key %> && 'bg-amber-50 dark:bg-amber-500/10'">
                                            <input type="color" x-model="colors.<%= key %>" @input="preview()" aria-label="<%= label %>"
                                                   class="size-9 shrink-0 cursor-pointer rounded-lg border border-zinc-300 bg-white p-0.5 dark:border-zinc-700 dark:bg-zinc-950">
                                            <div class="min-w-0 flex-1">
                                                <p class="text-xs font-medium"><%= label %></p>
                                                <input type="text" name="<%= key %>" x-model="colors.<%= key %>" @change="preview()" value="<%= activeColors[key] %>" pattern="#[0-9a-fA-F]{6}" required
                                                       class="w-full bg-transparent font-mono text-xs text-zinc-500 outline-none focus:text-zinc-900 dark:focus:text-zinc-100" aria-label="<%= label %> hex">
                                            </div>
                                            <button type="button" x-show="colors.<%= key %> !== defaults.<%= key %>" x-cloak x-transition.opacity
                                                    @click="colors.<%= key %> = defaults.<%= key %>; preview()" title="Back to theme default"
                                                    class="btn btn-ghost size-7 rounded-md p-0"><%- include('partials/icon', { name: 'x', cls: 'size-3.5' }) %></button>
                                        </div>
                                    <% }) %>
                                </div>
                                <div class="mt-4 flex flex-wrap items-center justify-end gap-2">
                                    <% if (overridden.length) { %>
                                        <button type="submit" form="theme-reset" class="btn btn-ghost">Reset to theme colors</button>
                                    <% } %>
                                    <button type="submit" class="btn btn-primary">Save colors</button>
                                </div>
                            </form>
                            <form id="theme-reset" action="/admin/themes/colors/reset" method="POST" hidden></form>
                        <% } else { %>
                            <form action="/admin/appearance" method="POST" x-data="{ color: <%= JSON.stringify(basePalette.base) %> }">
                                <label class="label" for="containerColor">Base color</label>
                                <div class="flex flex-wrap items-center gap-3">
                                    <input type="color" x-model="color" aria-label="Pick base color"
                                           class="h-10 w-14 cursor-pointer rounded-xl border border-zinc-300 bg-white p-1 dark:border-zinc-700 dark:bg-zinc-950">
                                    <input class="input w-32 font-mono" type="text" id="containerColor" name="containerColor" x-model="color"
                                           value="<%= basePalette.base %>" pattern="#[0-9a-fA-F]{6}" required>
                                    <button type="submit" class="btn btn-primary">Save color</button>
                                </div>
                                <p class="hint">Your page background. Text and button colors are picked automatically for contrast.</p>
                            </form>
                        <% } %>
                    </div>
                </section>

                <!-- Backup -->
                <section id="backup" class="card animate-fade-up [animation-delay:250ms]">
                    <div class="card-header">
                        <h2 class="card-title"><%- include('partials/icon', { name: 'database' }) %> Backup</h2>
                        <a href="/admin/export" hx-boost="false" download class="btn btn-secondary btn-sm">
                            <%- include('partials/icon', { name: 'download', cls: 'size-3.5' }) %> Export JSON
                        </a>
                    </div>
                    <form action="/admin/import" method="POST" class="card-body grid gap-3"
                          hx-confirm="Importing replaces your links, settings and icons. Continue?"
                          x-data="{ content: '' }">
                        <p class="text-sm text-zinc-600 dark:text-zinc-400">Restore a previous export. Analytics are not affected.</p>
                        <label class="btn btn-secondary justify-self-start">
                            <%- include('partials/icon', { name: 'upload' }) %> Choose file
                            <input type="file" accept="application/json,.json" class="sr-only"
                                   @change="$event.target.files[0]?.text().then(text => content = text)">
                        </label>
                        <textarea name="dbContent" x-model="content" class="input min-h-32 font-mono text-xs" placeholder="…or paste the exported JSON here"></textarea>
                        <div class="flex justify-end">
                            <button type="submit" class="btn btn-primary" :disabled="!content.trim()">Import &amp; replace</button>
                        </div>
                    </form>
                </section>
            </div>

            <aside class="hidden lg:block">
                <div class="sticky top-20 animate-fade-in">
                    <p class="mb-3 flex items-center gap-2 text-sm font-medium text-zinc-500 dark:text-zinc-400">
                        <%- include('partials/icon', { name: 'phone' }) %> Preview
                    </p>
                    <%- include('partials/preview') %>
                </div>
            </aside>
        </div>
    </main>

    <%- include('partials/toast') %>
</body>
</html>
