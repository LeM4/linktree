<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/admin-head') %>
    <title>Analytics · Linktree</title>
</head>
<body class="min-h-dvh bg-zinc-50 font-sans text-zinc-900 antialiased dark:bg-zinc-950 dark:text-zinc-100">
    <%- include('partials/admin-header') %>

    <% const a = analyticsData; %>
    <main class="mx-auto max-w-6xl space-y-6 px-4 py-8 sm:px-6 lg:py-10">
        <div class="flex flex-wrap items-end justify-between gap-4 animate-fade-up">
            <div>
                <h1 class="text-2xl font-semibold tracking-tight">Analytics</h1>
                <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">Click any link, country or referrer to exclude it from the numbers.</p>
            </div>
        </div>

        <% if (hasFilters) { %>
            <div class="card flex flex-wrap items-center gap-2 px-4 py-3 animate-fade-up">
                <span class="mr-1 flex items-center gap-1.5 text-sm font-medium text-zinc-500 dark:text-zinc-400"><%- include('partials/icon', { name: 'filter' }) %> Excluding</span>
                <% const chips = [
                    ...filters.excludedLinks.map(v => ['excludedLinks', v]),
                    ...filters.excludedCountries.map(v => ['excludedCountries', v]),
                    ...filters.excludedReferrers.map(v => ['excludedReferrers', v]),
                ]; %>
                <% chips.forEach(([key, value]) => { %>
                    <a href="<%= removeFilter(key, value) %>" class="group inline-flex max-w-xs items-center gap-1.5 rounded-full bg-zinc-100 py-1 pr-2 pl-3 text-xs font-medium text-zinc-700 transition hover:bg-red-50 hover:text-red-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-red-500/10 dark:hover:text-red-300" title="Remove filter">
                        <span class="truncate"><%= value %></span>
                        <%- include('partials/icon', { name: 'x', cls: 'size-3 opacity-60 group-hover:opacity-100' }) %>
                    </a>
                <% }) %>
                <a href="/analytics" class="ml-auto text-xs font-medium text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100">Clear all</a>
            </div>
        <% } %>

        <div class="grid grid-cols-2 gap-3 lg:grid-cols-4 animate-fade-up [animation-delay:50ms]">
            <% [
                ['Total visits', a.totalVisits],
                ['Unique visitors', a.uniqueVisitors],
                ['Link clicks', a.totalClicks],
                ['Clicks per visit', a.totalVisits ? (a.totalClicks / a.totalVisits).toFixed(2) : '–'],
            ].forEach(([label, value]) => { %>
                <div class="card px-5 py-4">
                    <p class="text-xs font-medium text-zinc-500 dark:text-zinc-400"><%= label %></p>
                    <p class="mt-1 text-3xl font-semibold tracking-tight tabular-nums"><%= value %></p>
                </div>
            <% }) %>
        </div>

        <section class="card animate-fade-up [animation-delay:100ms]">
            <div class="card-header"><h2 class="card-title"><%- include('partials/icon', { name: 'chart' }) %> Last 12 hours</h2></div>
            <div class="card-body"><div class="relative h-72"><canvas id="visitations-chart"></canvas></div></div>
        </section>

        <div class="grid gap-6 lg:grid-cols-3 animate-fade-up [animation-delay:150ms]">
            <% [
                ['Top links', a.topLinks, 'link_url', 'excludedLinks'],
                ['Top countries', a.topCountries, 'country', 'excludedCountries'],
                ['Top referrers', a.topReferrers, 'referrer', 'excludedReferrers'],
            ].forEach(([title, rows, field, key]) => { %>
                <section class="card">
                    <div class="card-header"><h2 class="card-title"><%= title %></h2></div>
                    <div class="card-body">
                        <% if (!rows.length) { %>
                            <p class="py-6 text-center text-sm text-zinc-500">No data yet</p>
                        <% } else { const max = rows[0].count; %>
                            <ul class="space-y-1.5">
                                <% rows.slice(0, 8).forEach(row => { const label = row[field] || 'unknown'; %>
                                    <li>
                                        <a href="<%= addFilter(key, row[field] || '') %>" title="Exclude <%= label %>"
                                           class="group relative flex items-center justify-between gap-3 overflow-hidden rounded-lg px-3 py-1.5 text-sm transition hover:bg-zinc-50 dark:hover:bg-zinc-800/60">
                                            <span class="absolute inset-y-0 left-0 rounded-lg bg-indigo-500/10 transition-all duration-500 dark:bg-indigo-400/15" style="width: <%= Math.max(4, Math.round((row.count / max) * 100)) %>%"></span>
                                            <span class="relative truncate group-hover:line-through"><%= label %></span>
                                            <span class="relative font-semibold tabular-nums"><%= row.count %></span>
                                        </a>
                                    </li>
                                <% }) %>
                            </ul>
                        <% } %>
                    </div>
                </section>
            <% }) %>
        </div>

        <div class="grid gap-6 lg:grid-cols-2 animate-fade-up [animation-delay:200ms]">
            <section class="card">
                <div class="card-header"><h2 class="card-title">Visits per day</h2></div>
                <div class="card-body"><div class="relative h-72"><canvas id="daily-chart"></canvas></div></div>
            </section>
            <section class="card">
                <div class="card-header"><h2 class="card-title">Link clicks by country</h2></div>
                <div class="card-body"><div class="relative h-72"><canvas id="polar-chart"></canvas></div></div>
            </section>
            <section class="card">
                <div class="card-header"><h2 class="card-title">Top links</h2></div>
                <div class="card-body"><div class="relative h-72"><canvas id="top-links-pie-chart"></canvas></div></div>
            </section>
            <section class="card">
                <div class="card-header"><h2 class="card-title">Top countries</h2></div>
                <div class="card-body"><div class="relative h-72"><canvas id="top-countries-pie-chart"></canvas></div></div>
            </section>
        </div>
    </main>

    <script type="application/json" id="analytics-data"><%- json(analyticsData) %></script>
    <script src="<%= asset('vendor/chart.umd.min.js') %>"></script>
    <script>
        (function () {
            const data = JSON.parse(document.getElementById('analytics-data').textContent);
            const dark = matchMedia('(prefers-color-scheme: dark)').matches;

            Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
            Chart.defaults.color = dark ? '#a1a1aa' : '#71717a';
            Chart.defaults.borderColor = dark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)';
            Chart.defaults.maintainAspectRatio = false;
            Chart.defaults.plugins.legend.labels.usePointStyle = true;
            Chart.defaults.plugins.legend.labels.boxWidth = 8;

            const palette = ['#6366f1', '#ec4899', '#f59e0b', '#10b981', '#06b6d4', '#8b5cf6', '#ef4444', '#84cc16', '#14b8a6', '#f97316'];
            const color = (i, alpha = 1) => {
                const hex = palette[i % palette.length];
                const n = parseInt(hex.slice(1), 16);
                return `rgba(${n >> 16}, ${(n >> 8) & 255}, ${n & 255}, ${alpha})`;
            };
            const empty = (rows) => !rows || rows.length === 0;
            const legendBottom = { plugins: { legend: { position: 'bottom' } } };

            const hourlyCtx = document.getElementById('visitations-chart');
            const gradient = hourlyCtx.getContext('2d').createLinearGradient(0, 0, 0, 280);
            gradient.addColorStop(0, color(0, 0.25));
            gradient.addColorStop(1, color(0, 0));
            new Chart(hourlyCtx, {
                type: 'line',
                data: {
                    labels: data.hourly.labels,
                    datasets: [
                        { label: 'All visits', data: data.hourly.total, fill: true, backgroundColor: gradient, borderColor: color(0), tension: 0.35, pointRadius: 0, pointHoverRadius: 4, borderWidth: 2 },
                        ...data.hourly.byCountry.map((c, i) => ({
                            label: c.country || 'unknown', data: c.data, borderColor: color(i + 1), borderDash: [5, 5], tension: 0.35, pointRadius: 0, borderWidth: 1.5,
                        })),
                    ],
                },
                options: { interaction: { mode: 'index', intersect: false }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } }, x: { grid: { display: false } } }, ...legendBottom },
            });

            new Chart(document.getElementById('daily-chart'), {
                type: 'bar',
                data: {
                    labels: data.visitationsByDate.slice(-30).map(r => r.date),
                    datasets: [{ label: 'Visits', data: data.visitationsByDate.slice(-30).map(r => r.count), backgroundColor: color(0, 0.7), borderRadius: 6 }],
                },
                options: { scales: { y: { beginAtZero: true, ticks: { precision: 0 } }, x: { grid: { display: false } } }, plugins: { legend: { display: false } } },
            });

            const doughnut = (id, rows, label) => new Chart(document.getElementById(id), {
                type: 'doughnut',
                data: { labels: rows.map(r => r[label] || 'unknown'), datasets: [{ data: rows.map(r => r.count), backgroundColor: rows.map((_, i) => color(i, 0.85)), borderWidth: 0 }] },
                options: { cutout: '60%', ...legendBottom },
            });
            if (!empty(data.topLinks)) doughnut('top-links-pie-chart', data.topLinks.slice(0, 10), 'link_url');
            if (!empty(data.topCountries)) doughnut('top-countries-pie-chart', data.topCountries.slice(0, 10), 'country');

            if (!empty(data.polarChartData)) {
                const links = [...new Set(data.polarChartData.map(d => d.link))];
                new Chart(document.getElementById('polar-chart'), {
                    type: 'polarArea',
                    data: {
                        labels: data.polarChartData.map(d => d.label),
                        datasets: [{ data: data.polarChartData.map(d => d.count), backgroundColor: data.polarChartData.map(d => color(links.indexOf(d.link), 0.6)), borderWidth: 0 }],
                    },
                    options: { scales: { r: { ticks: { display: false } } }, plugins: { legend: { display: false } } },
                });
            }
        })();
    </script>
</body>
</html>
