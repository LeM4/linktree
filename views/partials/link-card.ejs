<% if (link.is_18_plus) { %>
    <a href="/go/<%= link.id %>" rel="nofollow" class="link-card"
       x-data="{ warned: false }" @click="if (!warned) { $event.preventDefault(); warned = true }">
        <span class="link-lead" title="Sensitive content"><%- include('icon', { name: 'eye-off', cls: 'size-[1.125rem]' }) %></span>
        <span class="relative grid">
            <span class="col-start-1 row-start-1 line-clamp-2 px-1 text-balance transition duration-300" :class="warned && 'opacity-0 -translate-y-1'"><%= link.title %></span>
            <span x-cloak class="col-start-1 row-start-1 truncate px-1 text-[0.875rem] opacity-0 transition duration-300" :class="warned ? 'opacity-100' : 'translate-y-1'">Sensitive content · tap again</span>
        </span>
        <span class="link-arrow"><%- include('icon', { name: 'external', cls: 'size-4' }) %></span>
    </a>
<% } else { %>
    <a href="/go/<%= link.id %>" rel="nofollow" class="link-card">
        <span aria-hidden="true"></span>
        <span class="line-clamp-2 px-1 text-balance"><%= link.title %></span>
        <span class="link-arrow" aria-hidden="true"><%- include('icon', { name: 'external', cls: 'size-4' }) %></span>
    </a>
<% } %>
