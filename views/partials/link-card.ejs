<% if (link.is_18_plus) { %>
    <a href="/go/<%= link.id %>" rel="nofollow" class="link-card"
       x-data="{ warned: false }" @click="if (!warned) { $event.preventDefault(); warned = true }">
        <span x-show="!warned" class="block"><%= link.title %></span>
        <span x-show="warned" x-cloak
              x-transition:enter="transition duration-300 ease-out"
              x-transition:enter-start="opacity-0 scale-95"
              class="block">
            <span class="flex items-center justify-center gap-2 font-bold">
                <%- include('icon', { name: 'eye-off', cls: 'size-5' }) %> 18+ Sensitive Content
            </span>
            <span class="mt-1 block text-sm opacity-80">This link may contain adult content. <u>Tap again to continue.</u></span>
        </span>
    </a>
<% } else { %>
    <a href="/go/<%= link.id %>" rel="nofollow" class="link-card"><%= link.title %></a>
<% } %>
