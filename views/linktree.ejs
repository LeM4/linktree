<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= settings.page_title || settings.username || 'Links' %></title>
    <meta name="description" content="<%= settings.bio || '' %>">
    <meta name="theme-color" content="<%= palette.base %>">
    <meta property="og:title" content="<%= settings.page_title || settings.username || 'Links' %>">
    <meta property="og:description" content="<%= settings.bio || '' %>">
    <meta property="og:type" content="profile">
    <% if (/^https?:\/\//.test(settings.profile_pic_url || '')) { %>
    <meta property="og:image" content="<%= settings.profile_pic_url %>">
    <% } %>
    <link rel="icon" href="/static/favicon.png">
    <link rel="preload" href="/static/fonts/arvo-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="<%= asset('styles.css') %>">
    <style>
        :root {
            --background-gradient: <%= palette.backgroundGradient %>;
            --container-gradient: <%= palette.containerGradient %>;
            --text-color: <%= palette.textColor %>;
            --link-color: <%= palette.linkColor %>;
            --link-text-color: <%= palette.linkTextColor %>;
        }
        <%- themeContent.css %>
    </style>
    <script defer src="<%= asset('vendor/alpine.min.js') %>"></script>
    <script defer src="<%= asset('vendor/fp.umd.min.js') %>"></script>
</head>
<body class="min-h-dvh font-display antialiased" style="background: var(--background-gradient); color: var(--text-color);"
      x-data="{ showPopup: <%= showCountryPopup ? 'true' : 'false' %> }">

    <div id="theme-background" class="fixed inset-0 -z-10"><%- themeContent.html %></div>

    <main class="mx-auto flex min-h-dvh w-full max-w-lg flex-col px-4 py-10 transition duration-500 ease-smooth sm:py-16"
          :class="showPopup && 'blur-sm scale-[0.99]'">
        <div class="rounded-[2rem] p-6 shadow-2xl animate-fade-up sm:p-8" style="background: var(--container-gradient);">
            <header class="flex flex-col items-center text-center">
                <% if (settings.profile_pic_url) { %>
                    <img src="<%= settings.profile_pic_url %>" alt="<%= settings.username %>" width="96" height="96"
                         class="size-24 rounded-full object-cover shadow-lg ring-4 ring-white/40">
                <% } else { %>
                    <div class="grid size-24 place-items-center rounded-full bg-black/10 text-4xl font-bold ring-4 ring-white/40">
                        <%= (settings.username || '?').trim().charAt(0).toUpperCase() %>
                    </div>
                <% } %>
                <h1 class="mt-4 text-2xl font-bold"><%= settings.username %></h1>
                <% if (settings.bio) { %>
                    <p class="mt-2 max-w-xs leading-relaxed whitespace-pre-line opacity-90"><%= settings.bio %></p>
                <% } %>
            </header>

            <% if (iconLinks.length) { %>
                <nav class="mt-6 flex flex-wrap justify-center gap-4" aria-label="Social links">
                    <% iconLinks.forEach(icon => { let host = ''; try { host = new URL(icon.url).hostname.replace(/^www\./, ''); } catch {} %>
                        <a href="<%= icon.url %>" target="_blank" rel="noopener noreferrer me" aria-label="<%= host %>"
                           class="size-9 transition duration-300 ease-smooth hover:-translate-y-0.5 hover:scale-110 [&>svg]:size-full"
                           style="color: var(--text-color);"><%- icon.svg_code %></a>
                    <% }) %>
                </nav>
            <% } %>

            <ul id="links" class="mt-8 flex flex-col gap-4">
                <% links.forEach((link, i) => { %>
                    <li class="animate-fade-up" style="animation-delay: <%= 80 + i * 60 %>ms">
                        <%- include('partials/link-card', { link }) %>
                    </li>
                <% }) %>
            </ul>
        </div>
    </main>

    <% if (showCountryPopup) { %>
        <div x-show="showPopup" x-cloak
             x-transition:enter="transition duration-300 ease-out"
             x-transition:enter-start="opacity-0"
             class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4 font-sans backdrop-blur-sm">
            <div x-show="showPopup"
                 x-transition:enter="transition duration-300 ease-out delay-75"
                 x-transition:enter-start="opacity-0 translate-y-4 scale-95"
                 role="dialog" aria-modal="true" aria-labelledby="country-title"
                 class="w-full max-w-sm rounded-3xl bg-white p-7 text-zinc-900 shadow-2xl">
                <h2 id="country-title" class="text-center text-xl font-bold">Select your country</h2>
                <p class="mt-2 mb-6 text-center text-sm text-zinc-600">We couldn't detect your country. Please pick it to see the links available to you.</p>
                <%- include('partials/country-selector', { countries }) %>
            </div>
        </div>
    <% } %>

    <script>
        window.addEventListener('DOMContentLoaded', function () {
            if (!window.FingerprintJS || !window.fetch) return;
            FingerprintJS.load({ monitoring: false })
                .then(function (fp) { return fp.get(); })
                .then(function (result) {
                    var body = new URLSearchParams({
                        fingerprint: result.visitorId,
                        referrer: document.referrer || '',
                        userId: localStorage.getItem('userId') || '',
                    });
                    return fetch('/track', { method: 'POST', body: body, credentials: 'same-origin' });
                })
                .then(function (res) { return res.ok ? res.json() : null; })
                .then(function (data) { if (data && data.userId) localStorage.setItem('userId', data.userId); })
                .catch(function () {});
        });
    </script>
    <script>
        <%- themeContent.js %>
    </script>
</body>
</html>
